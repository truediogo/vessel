; Engine configuration file.
; Generated for Project VESSEL (Godot 4.7)

config_version=5

[application]

config/name="Project VESSEL"
config/description="Stylized cel-shaded isometric fantasy RPG prototype"
run/main_scene="res://scenes/world_generator_demo.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

